/* ===== Tempel di PALING BAWAH src/styles.css =====
   Jalankan dulu migrate-theme.mjs supaya warna lama berubah menjadi variabel di bawah ini. */

/* ---------- PALET (diambil dari warna karya: oxblood, krem tua, zaitun, emas kusam) ---------- */
:root {
  color-scheme: light;
  --paper: #f4eee2;          /* latar: krem perkamen */
  --surface: #fbf7ee;        /* kartu, tabel, halaman buku */
  --surface-2: #ece4d3;      /* header tabel, placeholder, hover */
  --ink: #2b241f;
  --ink-soft: #52483f;
  --muted: #7b6f63;
  --faint: #a29684;
  --line: #ddd2bf;
  --line-strong: #cfc2ab;
  --red: #9b2f35;            /* oxblood */
  --red-pale: #ecd1c8;
  --green: #6d7c5c;          /* zaitun */
  --gold: #b08a3e;
  --shadow-block: #e4dac6;   /* bayangan keras ala kertas bertumpuk */
  --paper-glass: rgba(244, 238, 226, .88);
  --display: 'Cormorant Garamond', 'Playfair Display', Georgia, serif;
}
:root[data-theme='dark'] {
  color-scheme: dark;
  --paper: #0f161b;          /* biru-slate gelap (bukan hitam legam), terinspirasi langit hujan R1999 */
  --surface: #151f26;
  --surface-2: #1b2832;
  --ink: #efe6d5;            /* krem hangat */
  --ink-soft: #cdc6b8;
  --muted: #98a5ab;
  --faint: #5f717b;
  --line: #26353f;
  --line-strong: #34474f;
  --red: #e07a2e;            /* AKSEN: oranye (nama variabel tetap --red agar semua elemen ikut berubah) */
  --red-pale: #3a2518;
  --green: #8fb39a;
  --gold: #e3ad55;
  --shadow-block: #070b0e;
  --paper-glass: rgba(15, 22, 27, .88);
}

::selection { background: var(--red-pale); color: var(--ink); }

/* animasi halus saat ganti tema (dipasang sebentar oleh JS) */
.theme-anim, .theme-anim * { transition: background-color .35s, color .35s, border-color .35s, fill .35s, stroke .35s !important; }

/* ---------- TIPOGRAFI: serif klasik untuk judul ---------- */
.hero-copy h1, .page-intro h1, .simple-page h1,
.section-heading h2, .commission-cta h2, .order-banner h2,
.panel-title-row h2, .info-section h2, .info-section h3,
.leaf-title, .simple-card h2, .art-modal h2, .cover-title {
  font-family: var(--display);
  font-weight: 500;
  letter-spacing: -.015em;
  font-size-adjust: .46;      /* menyamakan ukuran visual dengan DM Sans */
}
.hero-copy h1, .page-intro h1 { line-height: .95; }
/* kata aksen (daydreams., moments., idea.) -> serif miring, bukan tulisan tangan */
.hero-copy h1 span, .page-intro h1 span, .commission-cta h2 em, .order-banner h2 em {
  font-family: var(--display); font-style: italic; font-weight: 500; letter-spacing: -.01em;
}
.info-section h2 span { font-family: var(--mono); font-style: normal; }   /* nomor 01 02 tetap mono */

/* ---------- MODE GELAP: penyesuaian khusus ---------- */
:root[data-theme='dark'] .paper-grain { opacity: .1; mix-blend-mode: screen; }
:root[data-theme='dark'] .paper-sheet img,
:root[data-theme='dark'] .artwork-image img,
:root[data-theme='dark'] .modal-img { filter: brightness(.95) contrast(1.03); }
:root[data-theme='dark'] .portrait-paper::before { border-color: var(--line-strong); }
:root[data-theme='dark'] .face.front:has(.cover),
:root[data-theme='dark'] .book-base { border: 1px solid var(--line-strong); }
:root[data-theme='dark'] .drawer-scrim,
:root[data-theme='dark'] .modal-scrim { background: rgba(4, 8, 11, .62); }

/* ---------- MODE GELAP: elemen beraksen oranye ---------- */
/* tombol utama: terisi oranye */
:root[data-theme='dark'] .primary-button,
:root[data-theme='dark'] .nav-cta,
:root[data-theme='dark'] .drawer-order,
:root[data-theme='dark'] .order-sticky {
  background: var(--red); border-color: var(--red); color: var(--paper);
}
:root[data-theme='dark'] .primary-button:hover,
:root[data-theme='dark'] .nav-cta:hover { background: transparent; color: var(--red); }
:root[data-theme='dark'] .drawer-order:hover { background: var(--ink); border-color: var(--ink); }

/* tombol sekunder: garis oranye */
:root[data-theme='dark'] .ghost-button { border-color: var(--red); color: var(--red); }
:root[data-theme='dark'] .ghost-button:hover { background: var(--red-pale); }

/* ikon sosial: lingkaran oranye */
:root[data-theme='dark'] .social-circle { border-color: color-mix(in srgb, var(--red) 70%, transparent); color: var(--red); }
:root[data-theme='dark'] .social-circle:hover { background: var(--red); border-color: var(--red); color: var(--paper); }

/* bingkai potret hero */
:root[data-theme='dark'] .portrait-paper {
  border-color: color-mix(in srgb, var(--red) 55%, transparent);
  box-shadow: 12px 13px 0 color-mix(in srgb, var(--red) 24%, var(--paper));
}
:root[data-theme='dark'] .portrait-paper::before { border-color: color-mix(in srgb, var(--red) 35%, transparent); }
:root[data-theme='dark'] .orbit { border-color: color-mix(in srgb, var(--red) 50%, transparent); }
:root[data-theme='dark'] .portrait-caption { color: var(--red); }
:root[data-theme='dark'] .stage-sticker { background: var(--paper); }

/* sampul buku ikut biru-slate */
:root[data-theme='dark'] .cover,
:root[data-theme='dark'] .face.front:has(.cover),
:root[data-theme='dark'] .book-base { background: #0a1015; }
:root[data-theme='dark'] .cover-title i { color: var(--red); }

/* ---------- TOMBOL GANTI TEMA ---------- */
.theme-toggle {
  display: grid; place-items: center; width: 34px; height: 34px; border: 0; border-radius: 50%;
  background: transparent; color: var(--muted); transition: background .2s, color .2s, transform .3s;
}
.theme-toggle:hover { background: var(--red-pale); color: var(--ink); transform: rotate(18deg); }